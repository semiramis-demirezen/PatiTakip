
@model PatiTakip.Models.Service

@{
    ViewData["Title"] = "Hizmet Sil";
}

<h2>Hizmet Sil</h2>

<div class="alert alert-warning">
    Bu hizmeti silmek istediğinize emin misiniz?
    Bu işlem geri alınamaz.
</div>

@* silinecek hizmetin bilgilerini gosteriyoruz *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>

        <p class="card-text">
            <strong>Hizmet Süresi:</strong>
            @Model.DurationMinutes dakika
        </p>

        <p class="card-text">
            <strong>Hizmet Ücreti:</strong>
            @Model.Price TL
        </p>
    </div>
</div>

@* silme islemini post istegiyle gonderiyoruz *@
<form asp-controller="Services"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Evet, Sil
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        İptal
    </a>
</form>
