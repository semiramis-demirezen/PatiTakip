
@* controller'dan gelen hizmet listesini aliyor *@
@model List<PatiTakip.Models.Service>

@{
    // sayfanin basligini belirliyor
    ViewData["Title"] = "Hizmetler";
}

<h2>Klinik Hizmetleri</h2>


@* hizmet ekleme sayfasina gidiyoruz *@
<a asp-controller="Services"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Yeni Hizmet Ekle
</a>


@* form gonderildikten sonra gelen mesaji gosteriyoruz *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}


<p>Kliniğimizde sunulan hizmetler:</p>

@* Bootstrap ile hizmetleri tablo halinde gösteriyoruz *@
<table class="table table-striped">
    <thead>
        <tr>
            <th>Hizmet Adı</th>
            <th>Süre (Dakika)</th>
            <th>Ücret (TL)</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @* listedeki her hizmet için bir satır olusturuyor *@
        @foreach (var service in Model)
        {
            <tr>
                <td>@service.Name</td>
                <td>@service.DurationMinutes</td>
                <td>@service.Price</td>
                <td>
                    @* hizmeti duzenleme sayfasina yonlendiriyoruz *@
                    <a asp-controller="Services" asp-action="Edit" asp-route-id="@service.Id" class="btn btn-warning btn-sm"> Düzenle </a>
                    @* hizmeti silme onay sayfasina yonlendiriyoruz *@
                    <a asp-controller="Services" asp-action="Delete" asp-route-id="@service.Id" class="btn btn-danger btn-sm"> Sil </a>
                </td>

            </tr>
        }
    </tbody>
</table>
