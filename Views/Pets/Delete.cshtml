
@model PatiTakip.Models.Pet

@{
    ViewData["Title"] = "Evcil Hayvan Sil";
}

<h2>Evcil Hayvan Sil</h2>

<div class="alert alert-warning">
    Bu evcil hayvanı silmek istediğinize emin misiniz?
    Bu işlem geri alınamaz.
</div>

@* silinecek hayvanin bilgilerini gosteriyoruz *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>

        <p class="card-text">
            <strong>Tür:</strong> @Model.Species
        </p>

        <p class="card-text">
            <strong>Irk:</strong> @Model.Breed
        </p>

        <p class="card-text">
            <strong>Kilo:</strong> @Model.Weight kg
        </p>
    </div>
</div>

@* silme islemini post istegiyle gonderiyoruz *@
<form asp-controller="Pets"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Evet, Sil
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        İptal
    </a>
</form>
