
@* controllerdan gelen pet listesini karşılıyoruz *@
@model List<PatiTakip.Models.Pet>

@{
    //sayfanın baslıgını belirliyoruz
    ViewData["Title"] = "Evcil Hayvanlar";
}

<h2>Evcil Hayvanlar</h2>


@* H05: Yeni evcil hayvan ekleme formuna geçiş. *@
<a asp-controller="Pets"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Yeni Evcil Hayvan Ekle
</a>


@* H04: POST işleminden sonra gelen mesajı gösteriyoruz. *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}


@* bootstrap ile tablo oluşturuyoruz *@
<table class="table table-striped">
    <thead>
        <tr>
            <th>Adı</th>
            <th>Türü</th>
            <th>Irkı</th>
            <th>Doğum Tarihi</th>
            <th>Kilo (kg)</th>
        </tr>
    </thead>

    <tbody>
        @* listedeki her hayvan icin bir satır olusturuyoruz *@
        @foreach (var pet in Model)
        {
            <tr>
                <td>@pet.Name</td>
                <td>@pet.Species</td>
                <td>@pet.Breed</td>
                <td>@pet.BirthDate?.ToString("dd.MM.yyyy")</td>
                <td>@pet.Weight kg</td>
            </tr>
        }
    </tbody>
</table>
