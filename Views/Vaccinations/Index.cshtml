
@* controllerdan gelen asi kayitlarini aliyoruz *@
@model List<PatiTakip.Models.Vaccination>

@{
    ViewData["Title"] = "Aşı Kayıtları";
}

<h2>Aşı Kayıtları</h2>

@* asi ekleme sayfasina yonlendiriyoruz *@
<a asp-controller="Vaccinations"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Yeni Aşı Kaydı Ekle
</a>


@* formdan gelen bilgilendirme mesajini gosteriyoruz *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}


<p>Evcil hayvanların aşı geçmişi ve sonraki aşı tarihleri</p>

@* asi kayitlarini tablo halinde gosteriyoruz *@
<table class="table table-striped">
    <thead>
        <tr>
            <th>Hayvan Numarası</th>
            <th>Aşı Adı</th>
            <th>Yapıldığı Tarih</th>
            <th>Sonraki Doz Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @* listedeki her asi kaydi icin bir satir olusturuyoruz *@
        @foreach (var vaccination in Model)
        {
            <tr>
                <td>@vaccination.PetId</td>
                <td>@vaccination.VaccineName</td>
                <td>@(vaccination.DateAdministered.ToString("dd.MM.yyyy"))</td>
                <td>@(vaccination.NextDoseDate.ToString("dd.MM.yyyy"))</td>
                <td>
                @* asi kaydini duzenleme sayfasina yonlendiriyoruz *@
                    <a asp-controller="Vaccinations" asp-action="Edit" asp-route-id="@vaccination.Id" class="btn btn-warning btn-sm">Düzenle</a>
                @*asi kaydini silme onay sayfasina yonlendiriyoruz*@
                    <a asp-controller="Vaccinations" asp-action="Delete" asp-route-id="@vaccination.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
