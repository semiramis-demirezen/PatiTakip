
@* asi ekleme formunda kullanacagimiz bilgileri aliyoruz *@
@model PatiTakip.ViewModels.VaccinationCreateViewModel

@{
    ViewData["Title"] = "Aşı Kaydı Ekle";
}

<h2>Yeni Aşı Kaydı Ekle</h2>

@* formdaki bilgileri controller a gonderiyoruz *@
<form asp-controller="Vaccinations" asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* hayvan numarasini aliyoruz *@
    <div class="mb-3">
        <label asp-for="PetId" class="form-label"></label>
        <input asp-for="PetId" class="form-control" data-val-number="Lütfen geçerli bir hayvan numarası giriniz" />
        <span asp-validation-for="PetId" class="text-danger"></span>
    </div>

    @* asi adini aliyoruz *@
    <div class="mb-3">
        <label asp-for="VaccineName" class="form-label"></label>
        <input asp-for="VaccineName" class="form-control" />
        <span asp-validation-for="VaccineName" class="text-danger"></span>
    </div>

    @* asinin yapildigi tarihi aliyoruz *@
    <div class="mb-3">
        <label asp-for="DateAdministered" class="form-label"></label>
        <input asp-for="DateAdministered"
               type="date"
               lang="tr-TR"
               class="form-control" />
        <span asp-validation-for="DateAdministered" class="text-danger"></span>
    </div>

    @* sonraki doz tarihini aliyoruz *@
    <div class="mb-3">
        <label asp-for="NextDoseDate" class="form-label"></label>
        <input asp-for="NextDoseDate"
               type="date"
               lang="tr-TR"
               class="form-control" />
        <span asp-validation-for="NextDoseDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>

    <a asp-controller="Vaccinations"
       asp-action="Index"
       class="btn btn-secondary">
        Geri Dön
    </a>
</form>

@* form hatalarini gostermek icin gerekli dosyayi ekliyoruz *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
