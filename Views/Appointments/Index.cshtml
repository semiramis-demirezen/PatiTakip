
@* controllerdan gelen randevu listesini aliyoruz *@
@model List<PatiTakip.Models.Appointment>

@{
    ViewData["Title"] = "Randevular";
}

<h2>Randevular</h2>

@* yeni randevu sayfasina yonlendiriyoruz *@
<a asp-controller="Appointments"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Yeni Randevu Oluştur
</a>

@* islem sonrasinda gelen mesaji gosteriyoruz *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<p>Kliniğimizde oluşturulan randevular:</p>

@* kucuk ekranlarda tablonun kaydirilmasini sagliyoruz *@
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Oluşturan Kişi</th>
                <th>Hayvan</th>
                <th>Veteriner Hekim</th>
                <th>Hizmet</th>
                <th>Başlangıç</th>
                <th>Bitiş</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @* kayit yoksa bilgilendirme mesaji gosteriyoruz *@
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center">
                        Henüz randevu bulunmuyor.
                    </td>
                </tr>
            }
            else
            {
                @* kayitli randevulari tabloya ekliyoruz *@
                @foreach (var appointment in Model)
                {
                    <tr>
                        @* olusturan kisi bilgisi yoksa mesaj gosteriyoruz *@
                        <td>
                            @(string.IsNullOrWhiteSpace(appointment.CreatedByName)
                                ? "Belirtilmemiş"
                                : appointment.CreatedByName)
                        </td>

                        @* randevuya ait isimleri gosteriyoruz *@
                        <td>@appointment.Pet.Name</td>
                        <td>@appointment.Veterinarian.FullName</td>
                        <td>@appointment.Service.Name</td>

                        @* randevunun baslangic zamanini gosteriyoruz *@
                        <td>
                            @(appointment.AppointmentDate.ToString("dd.MM.yyyy HH:mm"))
                        </td>

                        @* hizmet suresine gore bitis zamanini hesapliyoruz *@
                        <td>
                            @(appointment.AppointmentDate
                                .AddMinutes(appointment.Service.DurationMinutes)
                                .ToString("dd.MM.yyyy HH:mm"))
                        </td>

                        <td>@appointment.Status</td>

                        @* randevu duzenleme sayfasina yonlendiriyoruz *@
                        <td>
                            <a asp-controller="Appointments"
                               asp-action="Edit"
                               asp-route-id="@appointment.Id"
                               class="btn btn-warning btn-sm">
                                Düzenle
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
