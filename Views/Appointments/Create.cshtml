
@model PatiTakip.ViewModels.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Yeni Randevu Oluştur";
}

<h2>Yeni Randevu Oluştur</h2>

<p>Randevu oluşturmak için aşağıdaki bilgileri doldurunuz.</p>

@* randevu bilgilerini controller a gonderiyoruz *@
<form asp-controller="Appointments"
      asp-action="Create"
      method="post">

    @* formdaki genel dogrulama hatalarini gosteriyoruz *@
    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>
    

    @* randevuyu olusturan kisinin adini aliyoruz *@
    <div class="mb-3">
        <label asp-for="CreatedByName" class="form-label">
            Randevuyu Oluşturan Kişinin Adı Soyadı
        </label>

        <input asp-for="CreatedByName"
               class="form-control"
               placeholder="Adınızı ve soyadınızı giriniz" />

        <span asp-validation-for="CreatedByName"
              class="text-danger"></span>
    </div>


    @* kayitli hayvanlar arasindan secim yapiyoruz *@
    <div class="mb-3">
        <label asp-for="PetId" class="form-label">
            Evcil Hayvan
        </label>

        <select asp-for="PetId"
                asp-items="ViewBag.Pets"
                class="form-select">
            <option value="">Evcil hayvan seçiniz</option>
        </select>

        <span asp-validation-for="PetId"
              class="text-danger"></span>
    </div>

    @* kayitli veterinerler arasindan secim yapiyoruz *@
    <div class="mb-3">
        <label asp-for="VeterinarianId" class="form-label">
            Veteriner Hekim
        </label>

        <select asp-for="VeterinarianId"
                asp-items="ViewBag.Veterinarians"
                class="form-select">
            <option value="">Veteriner hekim seçiniz</option>
        </select>

        <span asp-validation-for="VeterinarianId"
              class="text-danger"></span>
    </div>

    @* kayitli hizmetler arasindan secim yapiyoruz *@
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label">
            Hizmet
        </label>

        <select asp-for="ServiceId"
                asp-items="ViewBag.Services"
                class="form-select">
            <option value="">Hizmet seçiniz</option>
        </select>

        <span asp-validation-for="ServiceId"
              class="text-danger"></span>
    </div>

    @* randevunun tarihini ve saatini seciyoruz *@
    <div class="mb-3">
        <label asp-for="AppointmentDate" class="form-label">
            Randevu Tarihi ve Saati
        </label>

        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />

        <span asp-validation-for="AppointmentDate"
              class="text-danger"></span>
    </div>

    @* randevuyu kaydetmek icin formu gonderiyoruz *@
    <button type="submit" class="btn btn-primary">
        Randevu Oluştur
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        İptal
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
