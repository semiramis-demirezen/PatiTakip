@* randevu formunda kullanacagimiz bilgileri aliyoruz *@
@model PatiTakip.ViewModels.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Randevu Oluştur";
}

<h2>Yeni Randevu Oluştur</h2>

@* formdaki bilgileri controller a gonderiyoruz *@
<form asp-controller="Appointments" asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* randevu alinacak hayvanin numarasini aliyoruz *@
    <div class="mb-3">
        <label asp-for="PetId" class="form-label"></label>
        <input asp-for="PetId" class="form-control" data-val-number="Lütfen geçerli bir hayvan numarası giriniz." />
        <span asp-validation-for="PetId" class="text-danger"></span>
    </div>

    @* veteriner numarasini aliyoruz *@
    <div class="mb-3">
        <label asp-for="VeterinarianId" class="form-label"></label>
        <input asp-for="VeterinarianId" class="form-control" data-val-number="Lütfen geçerli bir hayvan numarası giriniz." />
        <span asp-validation-for="VeterinarianId" class="text-danger"></span>
    </div>

    @* hizmet numarasini aliyoruz *@
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label"></label>
        <input asp-for="ServiceId" class="form-control" data-val-number="Lütfen geçerli bir hayvan numarası giriniz." />
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>

    @* randevu tarihini ve saatini aliyoruz *@
    <div class="mb-3">
        <label asp-for="AppointmentDate" class="form-label"></label>
        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>

    <a asp-controller="Appointments"
       asp-action="Index"
       class="btn btn-secondary">
        Geri Dön
    </a>
</form>

@* form hatalarini gostermek icin gerekli dosyayi ekliyoruz *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
