
@model PatiTakip.Models.Veterinarian

@{
    ViewData["Title"] = "Veteriner Hekim Sil";
}

<h2>Veteriner Hekim Sil</h2>

<div class="alert alert-warning">
    Bu veteriner hekimi silmek istediğinize emin misiniz?
    Bu işlem geri alınamaz.
</div>

@* silinecek veterinerin bilgilerini gosteriyoruz *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.FullName</h5>

        <p class="card-text">
            <strong>Uzmanlık Alanı:</strong>
            @Model.Specialty
        </p>
    </div>
</div>

@* silme islemini post istegiyle gonderiyoruz *@
<form asp-controller="Veterinarians"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Evet, Sil
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        İptal
    </a>
</form>
