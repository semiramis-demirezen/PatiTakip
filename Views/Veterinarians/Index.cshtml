
@* controllerdan gelen veteriner listesini aliyoruz *@
@model List<PatiTakip.Models.Veterinarian>

@{
    ViewData["Title"] = "Veteriner Hekimler";
}

<h2>Veteriner Hekimler</h2>

@* veteriner ekleme sayfasina yonlendiriyoruz *@
<a asp-controller="Veterinarians"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Yeni Veteriner Ekle
</a>

@* form gonderildikten sonra gelen mesaji gosteriyoruz *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<p>Kliniğimizde görev yapan veteriner hekimler:</p>

@* veterinerleri tablo halinde gosteriyoruz *@
<table class="table table-striped">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Uzmanlık Alanı</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @* listedeki her veteriner icin bir satir olusturuyoruz *@
        @foreach (var veterinarian in Model)
        {
            <tr>
                <td>@veterinarian.FullName</td>
                <td>@veterinarian.Specialty</td>

                @* veterineri duzenleme sayfasina yonlendiriyoruz *@
                <td>
                    <a asp-controller="Veterinarians"
                       asp-action="Edit"
                       asp-route-id="@veterinarian.Id"
                       class="btn btn-warning btn-sm">
                        Düzenle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
